# ==============================================================================
# AL SHUJAIAT FOUNDATION JAMMU & KASHMIR (ASFJK) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite - Safe for Browser)
# ------------------------------------------------------------------------------

# Supabase Project URL and Public Anonymous Key (Find in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Razorpay Key ID for Indian Donations & Subscriptions (Public Test / Live Key ID)
# e.g., rzp_test_xxxxxxxxxxxx or rzp_live_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Cloudflare Turnstile Bot Protection (Public Site Key)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_placeholder_site_key

# Foundation Application Public URL
VITE_APP_URL=https://asfjk.org

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Supabase Edge Functions / Backend ONLY)
# NEVER EXPOSE THESE IN REACT VITE ENVIRONMENT VARIABLES!
# Set these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Server-Side Admin Access with Bypass RLS)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Resend API Key for Transactional Emails (80G receipts, OTP verification, volunteer alerts)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Sender Email (Configured domain e.g., notifications@asfjk.org or onboarding@resend.dev)
# RESEND_FROM_EMAIL=Al Shujaiat Foundation <noreply@asfjk.org>

# Razorpay Key Secret (Server-Side Order Generation & HMAC-SHA256 Verification)
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Razorpay Webhook Secret (Asynchronous Webhook Signature Verification)
# RAZORPAY_WEBHOOK_SECRET=whsec_your_razorpay_webhook_secret

# Cloudflare Turnstile Secret Key (Server-Side Token Verification)
# TURNSTILE_SECRET_KEY=0x4AAAAAAAx_your_secret_turnstile_key
